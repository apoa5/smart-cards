CORS_ORIGINS=http://localhost:5173,https://smart-cards-olive.vercel.app

# Opt in to Groq hosted inference
# AI_PROVIDER=groq
# AI_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=

# Legacy compatibility for existing integrations
# AI_PROVIDER=legacy_openai
# AI_MODEL=gpt-3.5-turbo
# OPENAI_API_KEY=

# Vercel requires the shared limiter. Opt in on a direct local Flask server with 1.
# RATE_LIMIT_ENABLED=1
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_KEY_SECRET=
# RATE_LIMIT_NAMESPACE=smartcards
# RATE_LIMIT_GENERATION_REQUESTS=6
# RATE_LIMIT_GENERATION_WINDOW_SECONDS=600
# RATE_LIMIT_UPLOAD_REQUESTS=8
# RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
# RATE_LIMIT_GLOBAL_GENERATION_REQUESTS=100
# RATE_LIMIT_GLOBAL_GENERATION_WINDOW_SECONDS=86400
# AI_GENERATION_ENABLED=1
